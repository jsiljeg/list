---
/* Home. Photography leads here in a way it must not in the wine list: the list
   is a tool used standing up, this page is read while someone decides whether
   to come. The image slots are placeholders until a real shoot exists — that
   is the single biggest quality lever on a restaurant site and the one thing
   code cannot fake. */
import Base from "../layouts/Base.astro";
import dishes from "../data/generated/dishes.json";

/* Every live dish, in menu order, each carrying its wine. It was three picked
   by course, which was right for a static row and wrong for a rail — arrows
   with nine cards behind them are a tease, arrows with the whole menu behind
   them are a way to read it. Course order so it still scrolls like a meal. */
const ORDER = ["starters", "soups", "mains", "desserts"];
const featured = ORDER.flatMap((c) => dishes.filter((d) => d.course === c && d.wines.length));
---

<Base
  title="Theatrium by Filho — restoran u Zagrebu"
  description="Theatrium by Filho, Teslina 7, Zagreb. Autorska kuhinja u atriju Zagrebačkog kazališta mladih, uz kartu od 393 pića."
  wide={true}
>
  <section class="hero">
    <div class="hero-img" role="img" aria-label="Interijer restorana Theatrium"></div>
    <div class="hero-copy shell">
      <p class="eyebrow">Teslina 7, Zagreb</p>
      <h1>Predstava za iskusne<br />i znatiželjne</h1>
      <p class="lede">
        Autorska kuhinja u atriju Zagrebačkog kazališta mladih — i karta pića
        koja se čita kao vlastito poglavlje.
      </p>
      <p class="cta">
        <a class="btn btn-solid" href="/rezervacija/">Rezervacija</a>
        <a class="btn" href="/jelovnik/">Jelovnik</a>
      </p>
    </div>
  </section>

  <!-- The daily offer, as a theatre ticket pinned to the corner of the
       landing page (owner, 2026-10-02: visible, "but not standard"). It is
       not a section of the page because it is not always true: it exists only
       while a published offer exists for the current service day, and the
       script below reveals it — no offer, no ticket, nothing to hide. It is
       not in the nav for the same reason: a menu item that is empty every
       morning until the chef is back from the market is a broken link.
       It sits right after the hero in the DOM: on a desktop it floats in the
       corner, on a phone it is placed in the flow there, because floating it
       over a 390px screen covered the Rezervacija button. -->
  <aside class="ticket" id="daily-ticket" hidden aria-label="Dnevna ponuda">
    <button type="button" class="t-close" aria-label="Zatvori">×</button>
    <a class="t-link" href="/dnevna-ponuda/">
      <span class="t-photo" aria-hidden="true"></span>
      <span class="t-body">
        <span class="t-eyebrow">Danas s tržnice</span>
        <span class="t-dishes"></span>
        <span class="t-cta">Dnevna ponuda →</span>
      </span>
    </a>
  </aside>

  <div class="shell">
    <section class="section split">
      <div>
        <p class="eyebrow">Scenario</p>
        <h2>Jelo kao predstava</h2>
        <p>
          Tradicionalni standardi rastavljeni su i ponovno složeni na neočekivan
          način. Iz Repertoara se za ručak bira Predstava, od Prologa do Epiloga;
          za večeru se dodaju autorski festivali u šest i devet sljedova.
        </p>
        <p><a class="btn" href="/o-nama/">O nama</a></p>
      </div>
      <div class="frame" role="img" aria-label="Jelo iz Theatriuma"></div>
    </section>

    <section class="section">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Repertoire</p>
          <h2>Uz svako jelo, vino</h2>
          <p class="lede wide">
            Preporuka nije ukras — dolazi iz iste karte koju dobijete za stolom,
            uz {dishes.length} jela i 393 pića.
          </p>
        </div>
        <div class="rail-nav">
          <button type="button" class="rnav" id="dish-prev" aria-label="Prethodna jela">‹</button>
          <button type="button" class="rnav" id="dish-next" aria-label="Sljedeća jela">›</button>
        </div>
      </div>

      <ul class="cards rail" id="dish-rail">
        {featured.map((d) => (
          <li>
            <a href={`/jelovnik/${d.slug}/`}>
              <span class="c-img" aria-hidden="true"></span>
              <span class="c-body">
                <span class="c-name">{d.name.hr}</span>
                <span class="c-wine">uz {d.wines[0].name} · {d.wines[0].producer}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>

      <p class="more"><a class="btn" href="/jelovnik/">Cijeli jelovnik</a></p>
    </section>

    <section class="section band">
      <p class="eyebrow">Karta pića</p>
      <h2>393 pića, osam jezika</h2>
      <p class="lede wide">
        Vina, žestoka pića i vode — s pretragom, bilješkama i preporukom vina uz
        jelo. Ista karta koju gosti čitaju za stolom.
      </p>
      <p><a class="btn" href="https://theatrium.list.devinos.hr">Otvori kartu pića</a></p>
    </section>
  </div>

</Base>

<script>
  /* The ticket. One request to the public feed — the same one the wine list
     will read — and nothing at all on a day with no offer, or if the feed
     fails: the landing page never waits on it and never shows an empty box.
     Closing it holds for the rest of that service day on that device. */
  (async () => {
    const t = document.getElementById("daily-ticket");
    let data;
    try { data = await (await fetch("/api/dnevna-ponuda")).json(); } catch { return; }
    const o = data && data.offer;
    if (!o || !o.dishes || !o.dishes.length) return;
    const key = `ticket-closed-${data.date}`;
    try { if (localStorage.getItem(key)) return; } catch {}
    const names = o.dishes.slice(0, 3).map((d) => d.name.hr);
    const more = o.dishes.length - names.length;
    const box = t.querySelector(".t-dishes");
    names.forEach((n) => { const s = document.createElement("span"); s.textContent = n; box.append(s); });
    if (more > 0) { const s = document.createElement("span"); s.className = "t-more"; s.textContent = `i još ${more}`; box.append(s); }
    const photo = o.photos?.[0] || o.dishes.find((d) => d.photo)?.photo;
    const ph = t.querySelector(".t-photo");
    if (photo) ph.style.backgroundImage = `url("${photo}")`; else ph.remove();
    t.querySelector(".t-close").addEventListener("click", () => {
      t.classList.remove("in");
      setTimeout(() => (t.hidden = true), 300);
      try { localStorage.setItem(key, "1"); } catch {}
    });
    t.hidden = false;
    requestAnimationFrame(() => requestAnimationFrame(() => t.classList.add("in")));
  })();

  /* Same stepping as the press rail. One card per press, and the arrows
     disable at the ends so they never lie about there being more. */
  const rail = document.getElementById("dish-rail");
  const prev = document.getElementById("dish-prev");
  const next = document.getElementById("dish-next");

  function step(dir) {
    const card = rail.querySelector("li");
    if (!card) return;
    rail.scrollBy({ left: dir * (card.getBoundingClientRect().width + 16), behavior: "smooth" });
  }
  prev.addEventListener("click", () => step(-1));
  next.addEventListener("click", () => step(1));

  function paint() {
    const max = rail.scrollWidth - rail.clientWidth - 2;
    prev.disabled = rail.scrollLeft <= 2;
    next.disabled = rail.scrollLeft >= max;
  }
  rail.addEventListener("scroll", paint, { passive: true });
  addEventListener("resize", paint);
  paint();
</script>

<style>
  /* ---- the daily ticket ----
     A ticket stub: cream paper on the dark page, a perforated edge cut by
     two half-circle notches, slightly turned as if tucked into a frame. The
     only light surface on the site, which is the point — it is a note pinned
     to the page, not part of it. */
  .ticket {
    position: fixed; z-index: 30; right: clamp(12px, 3vw, 32px); bottom: clamp(12px, 3vw, 32px);
    width: min(340px, calc(100vw - 24px));
    color: #1d1b18;
    /* drop-shadow, not box-shadow: the notches are a mask on .t-link, and a
       filter on the parent follows the masked shape where a box-shadow would
       draw a rectangle behind the holes */
    filter: drop-shadow(0 16px 28px rgba(0,0,0,.5));
    transform: translateY(130%) rotate(-2deg);
    transition: transform .55s cubic-bezier(.2,.9,.25,1.1);
  }
  .ticket.in { transform: translateY(0) rotate(-2deg); }
  @media (prefers-reduced-motion: reduce) { .ticket { transition: none; } }
  .ticket[hidden] { display: none; }
  @media (max-width: 700px) {
    .ticket {
      position: relative; right: auto; bottom: auto; z-index: 1;
      margin: -1.5rem auto 0; width: min(340px, calc(100% - 32px));
      transform: rotate(-2deg); opacity: 0; transition: opacity .5s ease;
    }
    .ticket.in { transform: rotate(-2deg); opacity: 1; }
  }
  .t-link {
    display: flex; text-decoration: none; color: inherit; background: #efe6d2;
    -webkit-mask: radial-gradient(circle 9px at 0 50%, transparent 98%, #000) left / 51% 100% no-repeat,
                  radial-gradient(circle 9px at 100% 50%, transparent 98%, #000) right / 51% 100% no-repeat;
            mask: radial-gradient(circle 9px at 0 50%, transparent 98%, #000) left / 51% 100% no-repeat,
                  radial-gradient(circle 9px at 100% 50%, transparent 98%, #000) right / 51% 100% no-repeat;
  }
  .t-photo {
    flex: 0 0 96px; background: #c9a961 center / cover no-repeat;
    border-right: 2px dashed rgba(29,27,24,.35);
  }
  .t-body { display: flex; flex-direction: column; gap: .15rem; padding: .95rem 2.2rem .95rem 1.1rem; min-width: 0; }
  .t-eyebrow { font-size: .68rem; letter-spacing: .22em; text-transform: uppercase; color: #8a6d2c; }
  .t-dishes { display: flex; flex-direction: column; font-family: var(--serif); font-size: 1.22rem; line-height: 1.15; }
  .t-dishes span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .t-dishes .t-more { font-family: var(--sans); font-size: .8rem; color: #6b6355; margin-top: .15rem; }
  .t-cta { margin-top: .45rem; font-size: .75rem; letter-spacing: .14em; text-transform: uppercase; color: #1d1b18; border-bottom: 1px solid currentColor; align-self: flex-start; }
  .t-link:hover .t-cta, .t-link:focus-visible .t-cta { color: #8a6d2c; }
  .t-close {
    position: absolute; top: .35rem; right: .45rem; width: 32px; height: 32px;
    border: 0; background: none; color: #6b6355; font-size: 1.3rem; cursor: pointer; line-height: 1;
    z-index: 1; /* above .t-link, which is later in the DOM and would take the tap */
  }
  .t-close:hover { color: #1d1b18; }

  .hero { position: relative; display: grid; }
  .hero-img {
    grid-area: 1 / 1;
    min-height: min(78svh, 720px);
    /* Placeholder until the shoot exists — a warm gradient rather than a stock
       photo, because a wrong photograph reads worse than none. */
    background:
      radial-gradient(120% 90% at 30% 20%, #2b2721 0%, transparent 60%),
      linear-gradient(160deg, #1c1a17 0%, #100f0e 100%);
  }
  .hero-copy {
    grid-area: 1 / 1; align-self: end;
    padding-bottom: clamp(2.5rem, 7vw, 5rem);
    position: relative;
  }
  .hero h1 { margin: 0 0 1rem; }
  .lede { color: var(--text-dim); font-size: 1.15rem; max-width: 34rem; }
  .lede.wide { max-width: 44rem; }
  .cta { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.8rem; }

  .split {
    display: grid; gap: clamp(1.5rem, 5vw, 4rem);
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    align-items: center;
  }
  .split p { color: var(--text-dim); max-width: 36rem; }
  .split h2 { margin-bottom: 1rem; }
  .frame {
    aspect-ratio: 4 / 3; border: 1px solid var(--line);
    background: linear-gradient(140deg, #221f1b, #15140f);
  }

  /* The heading and the arrows share a line: the controls belong to the row
     they drive, and putting them at the top means they are visible before a
     guest has scrolled past the thing they control. */
  .sec-head {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: 1.5rem; flex-wrap: wrap;
  }
  .cards {
    list-style: none; margin: 2.5rem 0 0; padding: 0 0 1rem;
  }
  .cards li { flex: 0 0 auto; width: min(19rem, 78vw); scroll-snap-align: start; }
  .cards a {
    display: block; height: 100%; text-decoration: none;
    border: 1px solid var(--line); background: var(--bg-card);
    transition: border-color .2s, transform .2s;
  }
  .cards a:hover, .cards a:focus-visible {
    border-color: var(--gold-soft); transform: translateY(-3px);
  }
  .c-img {
    display: block; aspect-ratio: 3 / 2;
    background: linear-gradient(140deg, #26221c, #16150f);
    border-bottom: 1px solid var(--line);
  }
  .c-body { display: block; padding: 1.1rem 1.2rem 1.3rem; }
  .c-name { font-family: var(--serif); font-size: 1.3rem; display: block; }
  .c-wine {
    display: block; margin-top: .4rem;
    font-size: .82rem; color: var(--gold-soft); letter-spacing: .05em;
  }
  .more { margin-top: 2.2rem; }

  .band {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .band h2 { margin-bottom: .8rem; }
  .band .btn { margin-top: 1.6rem; }
</style>
