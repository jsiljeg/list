---
/* Reservation — a real booking, confirmed on the spot.
 *
 * THE PICKER, third version. Two steppers and one row of times.
 *
 * The first put all 41 free slots on the page at once. The second narrowed it
 * to guests → day → hour → minutes, which was fewer choices but *more*
 * furniture: a 45-day strip that ran off the screen, eleven hour buttons each
 * with a count under it, then the times. The owner's word was "too much", and
 * a screenshot of it beside SevenRooms makes the point — theirs is three quiet
 * rows, and the quiet is the feature.
 *
 * So: guests and date are steppers, which take one line each and cannot
 * overflow however far ahead the calendar runs. Times stay a single scroller,
 * auto-scrolled to dinner, because "scroll to roughly when you want" was the
 * part worth keeping — it just did not need its own step to do it.
 *
 * NO NATIVE <input type="date">: its display format follows the operating
 * system's locale, not the page's, which is why it read mm/dd/yyyy, and
 * nothing in HTML or CSS can force dd/mm.
 *
 * STYLING: everything the script creates is styled in the global block below.
 * Astro scopes component CSS with a data-astro-cid attribute that elements
 * from document.createElement never receive, so scoped rules silently do not
 * match them — which is how the time buttons once shipped as bare browser
 * chrome. Namespaced under .book so nothing leaks. */
import Base from "../layouts/Base.astro";
import { CONFIG, SERVICE, nowInZagreb, addDays, weekday } from "../lib/booking.mjs";

const now = nowInZagreb();

const DOW_SHORT = ["ned", "pon", "uto", "sri", "čet", "pet", "sub"];
const days = [];
for (let i = 0; i < CONFIG.horizonDays; i++) {
  const iso = addDays(now.date, i);
  if (!(SERVICE[weekday(iso)] || []).length) continue; // closed days never appear
  days.push({
    iso,
    dow: DOW_SHORT[weekday(iso)],
    label: `${Number(iso.slice(8, 10))}.${Number(iso.slice(5, 7))}.`,
    today: i === 0,
  });
}
---

<Base
  title="Rezervacija — Theatrium by Filho"
  description="Rezervirajte stol u restoranu Theatrium by Filho, Teslina 7, Zagreb. Potvrda odmah."
>
  <header class="head">
    <p class="eyebrow">Rezervacija</p>
    <h1>Rezervirajte stol</h1>
    <p class="lede">
      Potvrda stiže odmah, e-poštom. Za grupe veće od {CONFIG.maxParty} osoba
      pogledajte <a href="/privatni-dogadaji/">privatne događaje</a> ili nas
      nazovite na <a href="tel:+385995844652">+385 99 5844 652</a>.
    </p>
  </header>

  <script type="application/json" id="days-data" set:html={JSON.stringify(days)} />

  <form class="book" id="book" novalidate>
    <div class="picker">
      <div class="prow">
        <span class="plabel">Gostiju</span>
        <div class="stepper">
          <button type="button" class="pbtn" id="cov-down" aria-label="Manje gostiju">−</button>
          <span class="pval" id="cov-val" aria-live="polite">2</span>
          <button type="button" class="pbtn" id="cov-up" aria-label="Više gostiju">+</button>
        </div>
      </div>
      <div class="prow">
        <span class="plabel">Datum</span>
        <div class="stepper">
          <button type="button" class="pbtn" id="day-prev" aria-label="Prethodni dan">‹</button>
          <span class="pval" id="day-val" aria-live="polite">&nbsp;</span>
          <button type="button" class="pbtn" id="day-next" aria-label="Sljedeći dan">›</button>
        </div>
      </div>
    </div>

    <fieldset class="step" id="step-time" hidden>
      <legend><span class="n">1</span> Slobodni termini</legend>
      <div class="timerow">
        <button type="button" class="tnav" id="t-prev" aria-label="Raniji termini">‹</button>
        <div class="slots" id="slots" role="group" aria-label="Vrijeme"></div>
        <button type="button" class="tnav" id="t-next" aria-label="Kasniji termini">›</button>
      </div>
      <p class="tmore" id="t-count"></p>
      <p id="slots-empty" class="empty" hidden>
        Tog dana nema slobodnih termina za toliko gostiju. Pokušajte s drugim
        danom ili nas nazovite.
      </p>
    </fieldset>

    <fieldset class="step" id="step-who" hidden>
      <legend><span class="n">2</span> Vaši podaci</legend>
      <p class="recap" id="recap"></p>
      <div class="row">
        <label>
          <span>Ime i prezime</span>
          <input type="text" name="name" required autocomplete="name" />
        </label>
        <label>
          <span>E-mail</span>
          <input type="email" name="email" required autocomplete="email" />
        </label>
      </div>
      <label>
        <span>Telefon <em>(za slučaj promjene)</em></span>
        <input type="tel" name="phone" autocomplete="tel" />
      </label>
      <label>
        <span>Napomena <em>(alergije, prigoda, stol)</em></span>
        <textarea name="note" rows="3"></textarea>
      </label>

      <label class="check">
        <input type="checkbox" name="privacy" value="yes" required />
        <span>
          Suglasan/na sam da se moji podaci koriste za obradu ove rezervacije.
          <a href="/privatnost/">Izjava o privatnosti</a>.
        </span>
      </label>
      <label class="check">
        <input type="checkbox" name="newsletter" value="yes" />
        <span>Želim primati obavijesti o novom jelovniku i vinima.</span>
      </label>

      <button class="btn btn-solid" type="submit" id="submit">Rezerviraj</button>
      <p class="err" id="err" hidden role="alert"></p>
    </fieldset>
  </form>

  <div class="done" id="done" hidden role="status">
    <h2>Rezervacija je potvrđena</h2>
    <p id="done-line"></p>
    <p class="muted">Potvrdu smo poslali e-poštom. Vidimo se.</p>
  </div>
</Base>

<script>
  const $ = (id) => document.getElementById(id);
  const form = $("book"), slotsBox = $("slots"), empty = $("slots-empty");
  const stepTime = $("step-time"), stepWho = $("step-who");
  const err = $("err"), submit = $("submit"), recap = $("recap");

  /* Open days come from the server, so the client never reimplements opening
     hours — one source for when the restaurant is actually open. */
  const DAYS = JSON.parse($("days-data").textContent);
  const PREFERRED_HOUR = 19;
  const MAX_PARTY = 8;

  const state = { covers: 2, dayIndex: 0, time: null };
  const WINDOW = 7;         // times shown at once
  let ALL = [];             // every free time for the chosen day
  let offset = 0;           // where the window starts
  const show = (el, on) => { el.hidden = !on; };

  const DOW = ["nedjelja", "ponedjeljak", "utorak", "srijeda", "četvrtak", "petak", "subota"];
  function human(iso) {
    const [y, m, d] = iso.split("-").map(Number);
    return DOW[new Date(Date.UTC(y, m - 1, d)).getUTCDay()] + ", " + d + "." + m + "." + y + ".";
  }

  function paint() {
    const d = DAYS[state.dayIndex];
    $("cov-val").textContent = String(state.covers);
    $("day-val").textContent = d.today ? "danas, " + d.label : d.dow + " " + d.label;
    $("cov-down").disabled = state.covers <= 1;
    $("cov-up").disabled = state.covers >= MAX_PARTY;
    $("day-prev").disabled = state.dayIndex <= 0;
    $("day-next").disabled = state.dayIndex >= DAYS.length - 1;
  }

  function bump(fn) { fn(); paint(); loadSlots(); }
  $("cov-down").addEventListener("click", () => bump(() => { state.covers = Math.max(1, state.covers - 1); }));
  $("cov-up").addEventListener("click", () => bump(() => { state.covers = Math.min(MAX_PARTY, state.covers + 1); }));
  $("day-prev").addEventListener("click", () => bump(() => { state.dayIndex = Math.max(0, state.dayIndex - 1); }));
  $("day-next").addEventListener("click", () => bump(() => { state.dayIndex = Math.min(DAYS.length - 1, state.dayIndex + 1); }));

  async function loadSlots() {
    state.time = null;
    show(stepWho, false);
    show(stepTime, true);
    show(empty, false);
    slotsBox.innerHTML = '<p class="loading">Tražimo slobodne termine…</p>';

    const date = DAYS[state.dayIndex].iso;
    let data;
    try {
      const r = await fetch("/api/availability?date=" + date + "&covers=" + state.covers);
      data = await r.json();
    } catch (e) {
      slotsBox.innerHTML = '<p class="loading">Nije moguće dohvatiti termine.</p>';
      return;
    }

    const slots = (data && data.slots) || [];
    if (!slots.length) { slotsBox.innerHTML = ""; show(empty, true); paintNav(); return; }

    /* A WINDOW, not the whole day. Showing every free time is what made this
       "too much" twice over — first as a wall of buttons, then as one very long
       row. Seven around the hour you want is an offer; forty-one is a list to
       work through. The arrows move the window, so nothing is unreachable. */
    ALL = slots;
    let nearest = 0, best = Infinity;
    slots.forEach((sl, i) => {
      const d = Math.abs(sl.start - PREFERRED_HOUR * 60);
      if (d < best) { best = d; nearest = i; }
    });
    offset = Math.max(0, Math.min(nearest - Math.floor(WINDOW / 2), slots.length - WINDOW));
    if (offset < 0) offset = 0;
    renderWindow();
    return;

  }

  function renderWindow() {
    const date = DAYS[state.dayIndex].iso;
    slotsBox.innerHTML = "";
    ALL.slice(offset, offset + WINDOW).forEach((sl) => {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "slot";
      b.textContent = sl.time;
      b.setAttribute("aria-pressed", String(state.time === sl.time));
      b.addEventListener("click", () => {
        state.time = sl.time;
        slotsBox.querySelectorAll(".slot").forEach((o) =>
          o.setAttribute("aria-pressed", String(o === b)));
        recap.textContent = human(date) + " u " + sl.time + " · " + state.covers +
          (state.covers === 1 ? " osoba" : " osobe");
        show(stepWho, true);
        stepWho.scrollIntoView({ behavior: "smooth", block: "nearest" });
      });
      slotsBox.appendChild(b);
    });
    paintNav();
  }

  function paintNav() {
    $("t-prev").disabled = offset <= 0;
    $("t-next").disabled = offset + WINDOW >= ALL.length;
    const c = $("t-count");
    c.textContent = ALL.length > WINDOW
      ? "još " + (ALL.length - WINDOW) + " termina tog dana"
      : "";
  }

  $("t-prev").addEventListener("click", () => {
    offset = Math.max(0, offset - WINDOW);
    renderWindow();
  });
  $("t-next").addEventListener("click", () => {
    offset = Math.min(Math.max(0, ALL.length - WINDOW), offset + WINDOW);
    renderWindow();
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!state.time) return;
    show(err, false);
    submit.disabled = true;
    submit.textContent = "Šaljemo…";

    const fd = new FormData(form);
    const date = DAYS[state.dayIndex].iso;
    let data;
    try {
      const r = await fetch("/api/reservations", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          date: date, time: state.time, covers: state.covers,
          name: fd.get("name"), email: fd.get("email"),
          phone: fd.get("phone"), note: fd.get("note"),
          consentPrivacy: fd.get("privacy") === "yes",
          newsletter: fd.get("newsletter") === "yes",
          locale: "hr",
        }),
      });
      data = await r.json();
    } catch (e2) { data = { error: "network" }; }

    submit.disabled = false;
    submit.textContent = "Rezerviraj";

    if (data && data.ok) {
      form.hidden = true;
      $("done-line").textContent = human(data.date) + " u " + data.time + " · " +
        data.covers + (data.covers === 1 ? " osoba" : " osobe");
      show($("done"), true);
      return;
    }

    const msgs = {
      "slot-taken": "Nažalost, taj je termin upravo zauzet. Odaberite drugi.",
      "too-soon": "Za rezervacije za danas nazovite nas, molimo.",
      "closed": "Tog smo dana zatvoreni.",
      "invalid": "Provjerite ispravnost podataka.",
      "no-database": "Rezervacije trenutno nisu dostupne. Nazovite nas, molimo."
    };
    err.textContent = msgs[data && data.error] ||
      "Nešto je pošlo po zlu. Pokušajte ponovno ili nas nazovite.";
    show(err, true);
    if (data && data.error === "slot-taken") loadSlots();
  });

  paint();
  loadSlots();
</script>

<style is:global>
  /* Global rather than scoped: half of what is styled here is created by the
     script, and Astro's scoping attribute never reaches those elements.
     Namespaced under .book / .head / .done so nothing leaks. */

  .book { max-width: 44rem; padding-bottom: var(--section); }

  /* the two steppers */
  .picker {
    display: flex; flex-wrap: wrap; gap: .8rem 2.5rem;
    padding: 1.1rem 0 1.9rem; margin-bottom: 1.6rem;
    border-bottom: 1px solid var(--line);
  }
  .prow { display: flex; align-items: center; gap: 1rem; }
  .plabel {
    font-size: .74rem; letter-spacing: .18em; text-transform: uppercase;
    color: var(--text-dim); min-width: 4.4rem;
  }
  .stepper { display: flex; align-items: center; gap: .2rem; }
  .pbtn {
    width: 2.1rem; height: 2.1rem; flex: none;
    background: none; color: var(--gold);
    border: 1px solid var(--line); border-radius: 50%;
    font-family: var(--sans); font-size: 1rem; line-height: 1;
    cursor: pointer; transition: border-color .15s, color .15s;
  }
  .pbtn:hover:not(:disabled) { border-color: var(--gold); }
  .pbtn:disabled { opacity: .3; cursor: default; }
  .pval {
    min-width: 8.5rem; text-align: center;
    font-family: var(--serif); font-size: 1.35rem; color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .prow:first-child .pval { min-width: 2.4rem; }

  .book .step { border: 0; padding: 0; margin: 0 0 2.4rem; }
  .book legend {
    font-size: .74rem; letter-spacing: .18em; text-transform: uppercase;
    color: var(--text-dim); margin-bottom: .9rem; padding: 0;
    display: flex; align-items: center; gap: .7rem;
  }
  .book .n {
    display: grid; place-items: center; width: 1.5rem; height: 1.5rem;
    border: 1px solid var(--gold-soft); color: var(--gold);
    border-radius: 50%; font-size: .74rem; font-family: var(--sans);
  }

  /* times: one scroller, never a grid that grows down the page */
  .book .slots {
    display: flex; gap: .45rem; overflow-x: auto; padding-bottom: .7rem;
    scroll-snap-type: x proximity;
    scrollbar-width: thin; scrollbar-color: var(--line) transparent;
  }
  .book .slots::-webkit-scrollbar { height: 5px; }
  .book .slots::-webkit-scrollbar-thumb { background: var(--line); border-radius: 3px; }
  .book .slot {
    flex: none; scroll-snap-align: center;
    padding: .6rem .95rem; min-width: 4.2rem;
    background: var(--bg-raised); color: var(--text);
    border: 1px solid var(--line); border-radius: 2px;
    font-family: var(--serif); font-size: 1.05rem;
    font-variant-numeric: tabular-nums; cursor: pointer;
    transition: border-color .15s, background-color .15s, color .15s;
  }
  .book .slot:hover { border-color: var(--gold-soft); }
  .book .slot[aria-pressed="true"] {
    background: var(--gold); border-color: var(--gold); color: var(--bg);
  }

  /* the time row: arrows either side, matching the wine list's stepping */
  .book .timerow { display: flex; align-items: center; gap: .5rem; }
  .book .tnav {
    width: 2.3rem; height: 2.3rem; flex: none;
    display: grid; place-items: center;
    background: var(--bg-card); border: 1px solid var(--line); border-radius: 50%;
    color: var(--gold-soft); font-size: 1.25rem; line-height: 1; cursor: pointer;
    transition: color .15s, border-color .15s;
  }
  /* Only where a pointer can hover: on a touch screen :hover latches after a
     tap and the ring stays lit long after the finger has gone. */
  @media (hover: hover) {
    .book .tnav:hover:not(:disabled) { color: var(--text); border-color: var(--gold); }
  }
  .book .tnav:disabled { opacity: .25; cursor: default; }
  .book .tmore {
    margin: .7rem 0 0; font-size: .78rem; letter-spacing: .06em;
    color: var(--text-faint);
  }

  .book .loading, .book .empty { color: var(--text-faint); margin: 0; }
  .book .recap {
    font-family: var(--serif); font-size: 1.15rem; color: var(--gold-soft);
    margin: 0 0 1.4rem;
  }

  .book .row { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); }
  .book label { display: block; margin-bottom: 1rem; }
  .book label > span {
    display: block; font-size: .74rem; letter-spacing: .14em;
    text-transform: uppercase; color: var(--text-dim); margin-bottom: .4rem;
  }
  .book label em { text-transform: none; letter-spacing: 0; color: var(--text-faint); font-style: normal; }
  .book input[type="text"], .book input[type="email"],
  .book input[type="tel"], .book textarea {
    width: 100%; background: var(--bg-raised); color: var(--text);
    border: 1px solid var(--line); padding: .75rem .9rem;
    font-family: var(--sans); font-size: 1rem; border-radius: 2px;
  }
  .book input:focus, .book textarea:focus { border-color: var(--gold-soft); outline: none; }
  .book .check { display: flex; gap: .7rem; align-items: flex-start; margin: 1.2rem 0; }
  .book .check input { width: auto; margin-top: .3rem; accent-color: var(--gold); }
  .book .check span { font-size: .95rem; color: var(--text-dim); line-height: 1.6; }
  .book .check a { color: var(--gold-soft); }
  .book button[type="submit"] { cursor: pointer; font-family: var(--sans); margin-top: .6rem; }
  .book .err { color: #e0866a; margin-top: 1rem; }

  .head { padding: 3.5rem 0 1.2rem; max-width: 44rem; }
  .head .lede { color: var(--text-dim); font-size: 1.1rem; }
  .head .lede a { color: var(--gold); }
  .done { max-width: 42rem; padding: 2rem 0 var(--section); }
  .done h2 { margin-bottom: .8rem; }
  .done p { color: var(--text-dim); margin: 0 0 .4rem; }
  .done .muted { color: var(--text-faint); }

  @media (max-width: 560px) {
    .picker { gap: .9rem 1.4rem; }
    .prow { width: 100%; justify-content: space-between; }
  }
</style>
