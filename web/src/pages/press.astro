  },
  {
    kind: "video",
    outlet: "Tipsy Podcast",
    title: "Filip Horvat o svom kuharskom putovanju, hrvatskim namirnicama i kako biti chef i vlasnik restorana",
    date: "2025-04-24",
    url: "https://www.youtube.com/watch?v=FtBjl40LDJk",
    note: "Dugi razgovor — kuhinja, namirnice i vođenje restorana.",
  },
  {
    kind: "video",
    outlet: "Best Food Croatia",
    title: "David Skoko: „Jeo sam labuda!“ · Theatrium by Filho",
    date: "2026-05-06",
    url: "https://www.youtube.com/watch?v=uFYQb3uCPEQ",
    note: "David Skoko u Theatriumu, za stolom s Filipom.",
  },
  {
    kind: "video",
    outlet: "Nova TV · dnevnik.hr",
    title: "Gostujući chef: Filip Horvat",
    date: "",
    url: "https://dnevnik.hr/video/gostujuci-chef-filip-horvat---63214608",
    note: "Televizijski prilog s chefom u ulozi gostujućeg kuhara.",
  },
];

const KIND = {
  vodic: "Vodič",
  putovanje: "S puta",
  intervju: "Intervju",
  recenzija: "Recenzija",
  tekst: "Tekst",
  video: "Video i podcast",
};

const MONTHS = ["siječnja","veljače","ožujka","travnja","svibnja","lipnja",
                "srpnja","kolovoza","rujna","listopada","studenoga","prosinca"];
const hrDate = (iso) => {
  if (!iso) return "";
  const [y, m, d] = iso.split("-").map(Number);
  return `${d}. ${MONTHS[m - 1]} ${y}.`;
};

const featured = ITEMS.filter((i) => i.featured);
/* Undated last: a missing date must not win the top of the page. */
const rest = ITEMS.filter((i) => !i.featured)
  .sort((a, b) => (b.date || "0").localeCompare(a.date || "0"));

/* Spread the outlets. Sorted purely by date, Plava kamenica landed four cards
   in a row and the rail read like one publication's feed rather than a range of
   coverage. This keeps the date order as the preference and only reaches past
   a card when its outlet just appeared — so the sequence stays roughly
   chronological without ever repeating a masthead back to back.

   Greedy and deliberately simple: take the newest item whose outlet differs
   from the last one placed; if every remaining item is from that outlet, take
   the newest anyway rather than contorting the order to avoid it. */
function spread(items) {
  const pool = [...items];
  const out = [];
  let last = null;
  while (pool.length) {
    let i = pool.findIndex((x) => x.outlet !== last);
    if (i === -1) i = 0;
    out.push(pool[i]);
    last = pool[i].outlet;
    pool.splice(i, 1);
  }
  return out;
}

const ordered = [...featured, ...spread(rest)];

const counts = Object.keys(KIND)
  .map((k) => ({ k, label: KIND[k], n: ITEMS.filter((i) => i.kind === k).length }))
  .filter((c) => c.n);

const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Press — Theatrium by Filho",
  numberOfItems: ITEMS.length,
  itemListElement: ITEMS.map((it, i) => ({
    "@type": "ListItem", position: i + 1, url: it.url, name: it.title,
  })),
};
---

<Base
  title="Press — Theatrium by Filho"
  description="Napisano o restoranu Theatrium by Filho i chefu Filipu Horvatu — intervjui, recenzije, vodiči i podcasti."
  schema={schema}
>
  <header class="head">
    <p class="eyebrow">Press</p>
    <h1>Napisano o nama</h1>
    <p class="lede">
      {ITEMS.length} tekstova, emisija i vodiča o Theatriumu i chefu Filipu
      Horvatu. Svaka poveznica vodi na izvornik.
    </p>
  </header>

  <div class="rail-head">
    <nav class="filters" id="filters" aria-label="Filtriraj">
      <button type="button" class="fchip" data-kind="all" aria-pressed="true">
        Sve <span class="n">{ITEMS.length}</span>
      </button>
      {counts.map((c) => (
        <button type="button" class="fchip" data-kind={c.k} aria-pressed="false">
          {c.label} <span class="n">{c.n}</span>
        </button>
      ))}
    </nav>
    <div class="rail-nav">
      <button type="button" class="rnav" id="rail-prev" aria-label="Prethodni">‹</button>
      <button type="button" class="rnav" id="rail-next" aria-label="Sljedeći">›</button>
    </div>
  </div>

  <div class="rail" id="rail">
    {ordered.map((it) => (
      <a class="card" data-kind={it.kind} href={it.url} rel="noopener nofollow" target="_blank">
        <span class="c-top">
          <span class="c-kind">{KIND[it.kind]}</span>
          {it.date && <time datetime={it.date}>{hrDate(it.date)}</time>}
        </span>
        <span class="c-outlet">{it.outlet}</span>
        <span class="c-title">{it.title}</span>
        <span class="c-note">{it.note}</span>
        <span class="c-go">Otvori <span aria-hidden="true">→</span></span>
      </a>
    ))}
  </div>

  <p class="foot">
    Pišete o nama? <a href="mailto:joy@theatrium.hr">joy@theatrium.hr</a>
  </p>
</Base>

<script>
  /* Filtering hides server-rendered cards — everything is in the HTML, so this
     works with JS off and a crawler sees all of it. */
  const rail = document.getElementById("rail");
  const chips = document.querySelectorAll("#filters .fchip");
  const prev = document.getElementById("rail-prev");
  const next = document.getElementById("rail-next");

  const visible = () => [...rail.querySelectorAll(".card")].filter((c) => !c.hidden);

  function step(dir) {
    const cards = visible();
    if (!cards.length) return;
    const w = cards[0].getBoundingClientRect().width + 16; // card + gap
    rail.scrollBy({ left: dir * w * 1, behavior: "smooth" });
  }
  prev.addEventListener("click", () => step(-1));
  next.addEventListener("click", () => step(1));

  function paintNav() {
    const max = rail.scrollWidth - rail.clientWidth - 2;
    prev.disabled = rail.scrollLeft <= 2;
    next.disabled = rail.scrollLeft >= max;
  }
  rail.addEventListener("scroll", paintNav, { passive: true });
  addEventListener("resize", paintNav);

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      const kind = chip.dataset.kind;
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
      rail.querySelectorAll(".card").forEach((c) => {
        c.hidden = kind !== "all" && c.dataset.kind !== kind;
      });
      rail.scrollTo({ left: 0, behavior: "smooth" });
      paintNav();
    });
  });

  paintNav();
</script>

<style>
  .head { padding: 3.5rem 0 1rem; max-width: 46rem; }
  .lede { color: var(--text-dim); font-size: 1.1rem; }

  .rail-head {
    display: flex; flex-wrap: wrap; align-items: center; gap: 1rem;
    margin: 2.4rem 0 1.4rem;
  }
  .filters { display: flex; flex-wrap: wrap; gap: .45rem; margin-right: auto; }
  .fchip {
    background: none; color: var(--text-dim);
    border: 1px solid var(--line); border-radius: 999px;
    padding: .42rem .95rem; cursor: pointer;
    font-family: var(--sans); font-size: .74rem;
    letter-spacing: .1em; text-transform: uppercase;
    transition: border-color .15s, color .15s, background-color .15s;
  }
  .fchip:hover { border-color: var(--gold-soft); color: var(--text); }
  .fchip[aria-pressed="true"] { background: var(--gold); border-color: var(--gold); color: var(--bg); }
  .fchip .n { opacity: .55; margin-left: .3rem; font-variant-numeric: tabular-nums; }

  .rail-nav { display: flex; gap: .4rem; }
  .rnav {
    width: 2.4rem; height: 2.4rem;
    display: grid; place-items: center;
    background: var(--bg-card); border: 1px solid var(--line); border-radius: 50%;
    color: var(--gold-soft); font-size: 1.3rem; line-height: 1; cursor: pointer;
    transition: color .15s, border-color .15s;
  }
  /* Hover only where a pointer exists: on touch, :hover latches after a tap. */
  @media (hover: hover) {
    .rnav:hover:not(:disabled) { color: var(--text); border-color: var(--gold); }
  }
  .rnav:disabled { opacity: .25; cursor: default; }

  /* the rail itself */
  .rail {
    display: flex; gap: 1rem;
    overflow-x: auto; scroll-snap-type: x mandatory;
    padding-bottom: 1rem;
    scrollbar-width: thin; scrollbar-color: var(--line) transparent;
  }
  .rail::-webkit-scrollbar { height: 6px; }
  .rail::-webkit-scrollbar-thumb { background: var(--line); border-radius: 3px; }

  /* A card is a grid so the CTA can sit at the bottom however long the title
     runs — otherwise the row of cards ends ragged. */
  .card {
    flex: 0 0 auto; width: min(23rem, 82vw);
    scroll-snap-align: start;
    display: grid; grid-template-rows: auto auto 1fr auto auto;
    gap: .55rem;
    padding: 1.5rem 1.6rem 1.4rem;
    background: var(--bg-card); border: 1px solid var(--line);
    text-decoration: none;
    transition: border-color .2s, transform .2s;
  }
  .card:hover, .card:focus-visible { border-color: var(--gold-soft); transform: translateY(-2px); }
  /* A class setting `display` beats the browser's own [hidden] rule, so the
     filter set the attribute on every card and nothing moved. Anything that
     declares display must restate this. */
  .card[hidden] { display: none; }

  .c-top { display: flex; align-items: baseline; justify-content: space-between; gap: .8rem; }
  .c-kind {
    font-size: .62rem; letter-spacing: .16em; text-transform: uppercase;
    color: var(--bg); background: var(--gold); padding: .2rem .5rem;
  }
  .c-top time { font-size: .74rem; color: var(--text-faint); white-space: nowrap; }
  .c-outlet {
    font-size: .72rem; letter-spacing: .2em; text-transform: uppercase;
    color: var(--gold-soft);
  }
  .c-title {
    font-family: var(--serif); font-size: 1.35rem; line-height: 1.28;
    color: var(--text); text-wrap: balance;
    /* Four lines maximum: a long headline must not make one card twice the
       height of its neighbours. */
    display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .c-note {
    color: var(--text-dim); font-size: .92rem; line-height: 1.55;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .c-go {
    margin-top: .3rem; font-size: .72rem; letter-spacing: .16em;
    text-transform: uppercase; color: var(--gold);
  }

  .foot { margin: 2.5rem 0 var(--section); color: var(--text-faint); font-size: .95rem; }
  .foot a { color: var(--gold-soft); }
</style>
