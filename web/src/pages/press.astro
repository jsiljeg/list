---
/* Press.
 *
 * WE LINK, WE NEVER REPUBLISH. Outlet, headline, date, link — and a sentence of
 * our own. The headline identifies a piece; everything in `note` is ours. An
 * article's text belongs to whoever paid for it, and reprinting it, reworded or
 * not, is an infringement however generously we credit it.
 *
 * NO IMAGES FROM THE ARTICLES, and no outlet logos: those belong to the
 * photographers and the publications, and a press page is a conspicuous place
 * to borrow either. Our own photography can join this after the shoot.
 *
 * BUILT TO SCALE. Filip is well covered and this list will keep growing, so
 * the page is designed for thirty entries rather than seven: one featured
 * piece, a filter by kind, then a dense reverse-chronological list grouped by
 * year. Adding coverage means adding a row to ITEMS — no layout work.
 *
 * Sorting is by date descending, and undated pieces sort last rather than
 * first: a missing date should not buy a piece the top of the page.
 *
 * Every link here was opened and confirmed. Two nearly shipped wrong — a search
 * result gave the Plava kamenica piece a slug that redirects, and my first
 * guess at the Večernji id was a different article. */
import Base from "../layouts/Base.astro";

/* kind: vodic | intervju | recenzija | tekst | video
   featured: at most one or two — the strongest thing we have. */
const ITEMS = [
  {
    kind: "vodic",
    outlet: "MICHELIN Guide",
    title: "Theatrium by Filho — Zagreb",
    date: "",
    url: "https://guide.michelin.com/rs/en/zagreb-region/zagreb/restaurant/theatrium-by-filho",
    /* Explicit on purpose: the restaurant is *in* the guide and does not hold a
       star. Implying otherwise is the worst error a press page can make. */
    note: "Restoran je uvršten u vodič — uvrštenje, bez zvjezdice.",
    featured: true,
  },
  {
    kind: "intervju",
    outlet: "Buro 24/7",
    title: "Filip Horvat: „Nismo zreli ni za Michelinovu zvjezdicu u Zagrebu, a kamoli za plant based restoran“",
    date: "2025-03-26",
    url: "https://buro247.hr/filip-horvat-theatrium-by-filho-intervju/",
    note: "Veliki intervju o zagrebačkoj sceni i o tome što restoranu treba prije nagrada. Razgovarala Ana Pavić.",
    featured: true,
  },
  {
    kind: "tekst",
    outlet: "Večernji list",
    title: "Iza kulisa zagrebačkog restorana Theatrium by Filho",
    date: "",
    url: "https://www.vecernji.hr/lifestyle/iza-kulisa-theratriuma-by-filho-jedan-dan-sa-chefom-filipom-horvatom-1514453",
    note: "Jedan dan s chefom, od nabave do servisa.",
  },
  {
    kind: "tekst",
    outlet: "Večernji list",
    title: "Posebna i smjela autorska kuhinja chefa Filipa Horvata",
    date: "",
    url: "https://www.vecernji.hr/zagreb/posebna-i-smjela-autorska-kuhinja-chefa-filipa-horvata-1412204",
    note: "O kuhinji koja rastavlja poznata jela i slaže ih iznova.",
  },
  {
    kind: "recenzija",
    outlet: "Plava kamenica",
    title: "U Theatriumu se odlično jede i fenomenalno pije",
    date: "2026-07-24",
    url: "https://plavakamenica.hr/2026/07/24/theatrium-restoran-zagreb-filip-horvat-caroni-rum/",
    note: "O kuhinji i o karti pića — uključujući bocu iz chefove privatne zalihe.",
  },
  {
    kind: "recenzija",
    outlet: "Eat Out Zagreb",
    title: "Chef Filip Horvat potpuno izluđuje goste",
    date: "2022-05-15",
    url: "https://www.eatoutzagreb.com/recenzije-restorani/chef-filip-horvat-potpuno-izluduje-goste/",
    note: "Recenzija iz perspektive gosta za stolom.",
  },
  {
    kind: "tekst",
    outlet: "Plava kamenica",
    title: "Theatrium je pobijedio: Filip Horvat preko puta restorana otvara novi",
    date: "2023-09-29",
    url: "https://plavakamenica.hr/2023/09/29/theatrium-je-pobijedio-filip-horvat-preko-puta-restorana-otvara-novi/",
    note: "O širenju preko puta — i o tome kako je Theatrium do toga došao.",
  },
  {
    kind: "tekst",
    outlet: "Plava kamenica",
    title: "Chef Horvat pronašao je formulu za uspjeh Theatriuma",
    date: "2020-05-14",
    url: "https://plavakamenica.hr/2020/05/14/chef-horvat-pronasao-je-formulu-za-uspjeh-theatriuma/",
    note: "Rani tekst, iz godine u kojoj je restoran pronašao svoj ton.",
  },
  {
    kind: "video",
    outlet: "Tipsy Podcast",
    title: "Filip Horvat o svom kuharskom putovanju, hrvatskim namirnicama i kako biti chef i vlasnik restorana",
    date: "2025-04-24",
    url: "https://www.youtube.com/watch?v=FtBjl40LDJk",
    note: "Dugi razgovor — kuhinja, namirnice i vođenje restorana.",
  },
  {
    kind: "video",
    outlet: "Best Food Croatia",
    title: "David Skoko: „Jeo sam labuda!“ · Theatrium by Filho",
    date: "2026-05-06",
    url: "https://www.youtube.com/watch?v=uFYQb3uCPEQ",
    note: "David Skoko u Theatriumu, za stolom s Filipom.",
  },
  {
    kind: "video",
    outlet: "Nova TV · dnevnik.hr",
    title: "Gostujući chef: Filip Horvat",
    date: "",
    url: "https://dnevnik.hr/video/gostujuci-chef-filip-horvat---63214608",
    note: "Televizijski prilog s chefom u ulozi gostujućeg kuhara.",
  },
];

const KIND = {
  vodic: "Vodič",
  intervju: "Intervju",
  recenzija: "Recenzija",
  tekst: "Tekst",
  video: "Video i podcast",
};

const MONTHS = ["siječnja","veljače","ožujka","travnja","svibnja","lipnja",
                "srpnja","kolovoza","rujna","listopada","studenoga","prosinca"];
const hrDate = (iso) => {
  if (!iso) return "";
  const [y, m, d] = iso.split("-").map(Number);
  return `${d}. ${MONTHS[m - 1]} ${y}.`;
};

const featured = ITEMS.filter((i) => i.featured);
/* Undated last: a missing date must not win the top of the page. */
const rest = ITEMS.filter((i) => !i.featured)
  .sort((a, b) => (b.date || "0").localeCompare(a.date || "0"));

/* Year buckets, undated collected at the end under their own heading. */
const years = [];
for (const it of rest) {
  const y = it.date ? it.date.slice(0, 4) : "—";
  const last = years[years.length - 1];
  if (last && last.year === y) last.items.push(it);
  else years.push({ year: y, items: [it] });
}

const counts = Object.keys(KIND)
  .map((k) => ({ k, label: KIND[k], n: ITEMS.filter((i) => i.kind === k).length }))
  .filter((c) => c.n);

const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Press — Theatrium by Filho",
  numberOfItems: ITEMS.length,
  itemListElement: ITEMS.map((it, i) => ({
    "@type": "ListItem", position: i + 1, url: it.url, name: it.title,
  })),
};
---

<Base
  title="Press — Theatrium by Filho"
  description="Napisano o restoranu Theatrium by Filho i chefu Filipu Horvatu — intervjui, recenzije, vodiči i podcasti."
  schema={schema}
>
  <header class="head">
    <p class="eyebrow">Press</p>
    <h1>Napisano o nama</h1>
    <p class="lede">
      {ITEMS.length} tekstova, emisija i vodiča o Theatriumu i chefu Filipu
      Horvatu. Svaka poveznica vodi na izvornik.
    </p>
  </header>

  {featured.length > 0 && (
    <section class="feature">
      {featured.map((it) => (
        <a class="fcard" href={it.url} rel="noopener nofollow" target="_blank">
          <span class="f-kind">{KIND[it.kind]}</span>
          <span class="f-outlet">{it.outlet}</span>
          <span class="f-title">{it.title}</span>
          <span class="f-note">{it.note}</span>
          <span class="f-go">Pročitaj <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </section>
  )}

  <nav class="filters" id="filters" aria-label="Filtriraj">
    <button type="button" class="fchip" data-kind="all" aria-pressed="true">
      Sve <span class="n">{ITEMS.length}</span>
    </button>
    {counts.map((c) => (
      <button type="button" class="fchip" data-kind={c.k} aria-pressed="false">
        {c.label} <span class="n">{c.n}</span>
      </button>
    ))}
  </nav>

  {years.map((grp) => (
    <section class="year" data-year={grp.year}>
      <h2 class="ytitle">{grp.year === "—" ? "Bez datuma" : grp.year}</h2>
      <ul class="items">
        {grp.items.map((it) => (
          <li data-kind={it.kind}>
            <a href={it.url} rel="noopener nofollow" target="_blank">
              <span class="p-head">
                <span class="p-outlet">{it.outlet}</span>
                <span class="p-kind">{KIND[it.kind]}</span>
                {it.date && <time datetime={it.date}>{hrDate(it.date)}</time>}
              </span>
              <span class="p-title">{it.title}</span>
              <span class="p-note">{it.note}</span>
              <span class="p-go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <p class="foot">
    Pišete o nama? <a href="mailto:joy@theatrium.hr">joy@theatrium.hr</a>
  </p>
</Base>

<script>
  /* Filtering is a class toggle over server-rendered markup — every item is in
     the HTML, so this works without JS and search sees all of it. */
  const chips = document.querySelectorAll("#filters .fchip");
  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      const kind = chip.dataset.kind;
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
      document.querySelectorAll(".items li").forEach((li) => {
        li.hidden = kind !== "all" && li.dataset.kind !== kind;
      });
      /* A year heading with nothing under it is noise. */
      document.querySelectorAll(".year").forEach((sec) => {
        sec.hidden = ![...sec.querySelectorAll("li")].some((li) => !li.hidden);
      });
    });
  });
</script>

<style>
  .head { padding: 3.5rem 0 1rem; max-width: 46rem; }
  .lede { color: var(--text-dim); font-size: 1.1rem; }

  /* the featured pieces */
  .feature {
    display: grid; gap: 1rem; margin: 2.4rem 0 2.8rem;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
  }
  .fcard {
    display: grid; align-content: start; gap: .5rem;
    padding: 1.6rem 1.7rem 1.5rem;
    background: var(--bg-card); border: 1px solid var(--line);
    text-decoration: none;
    transition: border-color .2s, transform .2s;
  }
  .fcard:hover, .fcard:focus-visible { border-color: var(--gold-soft); transform: translateY(-2px); }
  .f-kind {
    justify-self: start; font-size: .64rem; letter-spacing: .18em;
    text-transform: uppercase; color: var(--bg); background: var(--gold);
    padding: .2rem .55rem;
  }
  .f-outlet {
    font-size: .72rem; letter-spacing: .2em; text-transform: uppercase;
    color: var(--gold-soft); margin-top: .3rem;
  }
  .f-title {
    font-family: var(--serif); font-size: clamp(1.35rem, 2.3vw, 1.7rem);
    line-height: 1.25; color: var(--text); text-wrap: balance;
  }
  .f-note { color: var(--text-dim); font-size: .95rem; }
  .f-go {
    margin-top: .5rem; font-size: .74rem; letter-spacing: .16em;
    text-transform: uppercase; color: var(--gold);
  }

  /* filters */
  .filters {
    display: flex; flex-wrap: wrap; gap: .45rem;
    padding-bottom: 1.6rem; border-bottom: 1px solid var(--line);
  }
  .fchip {
    background: none; color: var(--text-dim);
    border: 1px solid var(--line); border-radius: 999px;
    padding: .42rem .95rem; cursor: pointer;
    font-family: var(--sans); font-size: .76rem;
    letter-spacing: .1em; text-transform: uppercase;
    transition: border-color .15s, color .15s, background-color .15s;
  }
  .fchip:hover { border-color: var(--gold-soft); color: var(--text); }
  .fchip[aria-pressed="true"] { background: var(--gold); border-color: var(--gold); color: var(--bg); }
  .fchip .n { opacity: .55; margin-left: .25rem; font-variant-numeric: tabular-nums; }

  /* the list */
  .year { padding-top: 2.2rem; }
  .ytitle {
    font-family: var(--sans); font-weight: 500;
    font-size: .74rem; letter-spacing: .22em; color: var(--text-faint);
    margin-bottom: .3rem;
  }
  .items { list-style: none; margin: 0; padding: 0; }
  .items li { border-bottom: 1px solid var(--line); }
  .items a {
    display: grid; grid-template-columns: 1fr auto; gap: .3rem 1.5rem;
    padding: 1.3rem 0; text-decoration: none;
    transition: padding-left .2s ease;
  }
  .items a:hover, .items a:focus-visible { padding-left: .7rem; }

  .p-head { grid-column: 1; display: flex; flex-wrap: wrap; align-items: baseline; gap: .7rem; }
  .p-outlet {
    font-size: .7rem; letter-spacing: .2em; text-transform: uppercase;
    color: var(--gold-soft);
  }
  .p-kind {
    font-size: .64rem; letter-spacing: .14em; text-transform: uppercase;
    color: var(--text-faint); border: 1px solid var(--line);
    padding: .05rem .4rem; border-radius: 2px;
  }
  time { font-size: .76rem; color: var(--text-faint); }
  .p-title {
    grid-column: 1; font-family: var(--serif);
    font-size: clamp(1.15rem, 2vw, 1.45rem); line-height: 1.3;
    color: var(--text); text-wrap: balance;
  }
  .p-note { grid-column: 1; color: var(--text-dim); font-size: .92rem; max-width: 52ch; }
  .p-go {
    grid-column: 2; grid-row: 1 / span 3; align-self: center;
    color: var(--gold); font-size: 1.2rem; opacity: 0;
    transform: translateX(-.4rem);
    transition: opacity .2s ease, transform .2s ease;
  }
  .items a:hover .p-go, .items a:focus-visible .p-go { opacity: 1; transform: none; }

  .foot { margin: 3.5rem 0 var(--section); color: var(--text-faint); font-size: .95rem; }
  .foot a { color: var(--gold-soft); }

  @media (max-width: 560px) {
    .items a { grid-template-columns: 1fr; }
    .p-go { display: none; }
  }
</style>
